rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /haikuPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'poem', 'place', 'lat', 'lng', 'category', 'authorId', 'authorName',
          'okashi', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.poem is string
        && request.resource.data.place is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow update: if request.auth != null
        && (
          resource.data.authorId == request.auth.uid
          || request.resource.data.diff(resource.data).changedKeys().hasOnly(['okashi', 'updatedAt'])
        );
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
  }
}
