rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function ownsUserId(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validPublicProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'id', 'displayName', 'icon', 'iconImage', 'bio',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 24
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        && request.resource.data.iconImage is string
        && request.resource.data.iconImage.size() <= 300000;
    }

    function isOwner(userId) {
      return signedIn() && ownsUserId(userId);
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if ownsUserId(userId) && validPublicProfile(userId);
      allow update: if isOwner(userId) && validPublicProfile(userId);
      allow delete: if isOwner(userId);
    }

    match /haikus/{haikuId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /replies/{replyId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /haikuReactions/{reactionId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /replyReactions/{reactionId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /friendships/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }
  }
}
